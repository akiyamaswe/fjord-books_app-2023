<div id="<%= dom_id report %>">
  <p>
    <strong><%= User.human_attribute_name(:name) %>:</strong>
    <% if report.user.nil? %>
    <strong><%= t('views.common.withdrawn') %></strong>
  <% else %>
    <strong><%= link_to report.user.name_or_email, report.user %></strong>
  <% end %>
  </p>

  <p>
    <strong><%= Report.human_attribute_name(:created_at) %>:</strong>
    <%= I18n.l report.created_at, format: :short %>
  </p>

  <p>
    <strong><%= Report.human_attribute_name(:title) %>:</strong>
    <%= report.title %>
  </p>

  <p>
    <strong><%= Report.human_attribute_name(:content) %>:</strong>
    <%= report.content %>
  </p>

</div>