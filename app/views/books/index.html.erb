<p style="color: green"><%= notice %></p>

<h1><%= t('controllers.index.header', model: Book.model_name.human) %></h1>

<div id="controllers" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to t('controllers.index.show', model: Book.model_name.human), book %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to t('controllers.index.new', model: Book.model_name.human), new_book_path %>
</nav>
